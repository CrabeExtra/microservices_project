{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=./Database/contact.db"
  },
  
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:6003"
      },
      "Https": {
        "Url": "https://0.0.0.0:5003",
        "Certificate": {
          "Path": "/path/to/certificate.pfx",
          "Password": "YOUR_CERTIFICATE_PASSWORD"
        }
      }
    }
  }
}
